# TEMPLATE. Verify every field against the NVIDIA Triton FIL backend documentation for the
# container version you pin. Replace N_FEATURES with the number of columns in results/*/model.json
# (see model.feature_names). Copy model.json into 1/ and set model_type to match the file format.
backend: "fil"
max_batch_size: 8192
input [ { name: "input__0" data_type: TYPE_FP32 dims: [ N_FEATURES ] } ]
output [ { name: "output__0" data_type: TYPE_FP32 dims: [ 1 ] } ]
instance_group [ { kind: KIND_GPU count: 1 } ]
parameters [
  { key: "model_type" value: { string_value: "xgboost_json" } },
  { key: "output_class" value: { string_value: "false" } },
  { key: "predict_proba" value: { string_value: "false" } }
]
